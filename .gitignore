# Canonical store and runtime state — regenerable from source data
data/canonical/
data/_state/
data/_index/
data/cache/

# Large source datasets that exceed reasonable git tracking thresholds
# (deferred to git-lfs migration in Phase 0.5+)
data/sources/dia/dia_chunks.json
data/sources/**/dia_chunks.json

# H9 AO (dia-tdv-scrape) — raw HTML archive + derived rich source file.
# Gitignored per ADR-014 (no raw-HTML redistribution; İSAM permission scope)
# and size. Re-generable from source + scraper (see adapter README).
data/sources/dia_html/
data/sources/dia_chunks_rich.json

